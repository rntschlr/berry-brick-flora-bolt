# Tinta — environment template (no real secrets)
# Copy to `.env` / Cloudflare Pages → Settings → Environment variables as needed.

# Auth (public Cloudflare builds keep this false)
VITE_AUTH_ENABLED=false

# Public standalone: strip Grok preview chrome / extensions.js
VITE_PUBLIC_STANDALONE=true
VITE_SHIP_GROK_CHROME=false

# Canonical origin used in sitemap / JSON-LD (no trailing slash)
VITE_PUBLIC_SITE_URL=https://tinta.pages.dev

# Nitro preset for Cloudflare Pages builds
# NITRO_PRESET=cloudflare-pages

# Optional: only needed if enabling Grok preview OAuth locally
# GROK_PREVIEW_CLIENT_SECRET=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_AUTH_ISSUER=https://auth.grok.me
# BETTER_AUTH_URL=http://localhost:8080
# BETTER_AUTH_SECRET=

# Cloudflare Pages deploy (GitHub Actions secrets — never commit)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
